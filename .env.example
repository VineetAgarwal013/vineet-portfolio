# Vercel (and local `tsx scripts/*`) environment variables.
# Copy to `.env.local` for local seeding; set these in the Vercel dashboard for production.
# DO NOT commit real values.

# --- Model provider selection (swap freely; only embedding swaps require a re-seed) ---
EMBEDDING_PROVIDER=gemini      # gemini | openai
LLM_PROVIDER=gemini           # gemini | openai

# --- Gemini (default) ---
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-3.5-flash

# --- OpenAI (optional swap) ---
OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=vineet-knowledge
# Index dimension must match the embedding model: Gemini=768, OpenAI=1536.
